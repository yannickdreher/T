{
  // F5 builds and starts the app in the debugger (needs the C# Dev Kit extension).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "T",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/T.UI/bin/Debug/net10.0/T.dll",
      "cwd": "${workspaceFolder}/T.UI",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
