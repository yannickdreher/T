{
  // The same commands as in AGENTS.md. Ctrl+Shift+B runs "build".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "T.slnx"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "--project", "T.Tests/T.Tests.csproj"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "lint",
      "type": "process",
      "command": "pwsh",
      "windows": { "command": "powershell" },
      "args": ["-NoProfile", "-File", "lint.ps1"],
      "problemMatcher": []
    },
    {
      "label": "lint: fix",
      "type": "process",
      "command": "pwsh",
      "windows": { "command": "powershell" },
      "args": ["-NoProfile", "-File", "lint.ps1", "-Fix"],
      "problemMatcher": []
    }
  ]
}
