<UserControl x:Class="T.UI.Views.Components.SftpExplorerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:T.UI.Models"
             xmlns:tm="using:T.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:T.UI.ViewModels"
             d:DesignHeight="600"
             d:DesignWidth="900"
             x:DataType="vm:SessionViewModel"
             DragDrop.AllowDrop="True"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:SessionViewModel />
    </Design.DataContext>

    <!--
        Laid out like the Windows 11 File Explorer: navigation + address bar + search,
        command bar, folder tree and details list with the shell's colored icons, status bar.
    -->
    <UserControl.Resources>
        <MenuFlyout x:Key="SortMenu" Placement="BottomEdgeAlignedLeft">
            <MenuItem Command="{Binding SortExplorerCommand}"
                      CommandParameter="Name"
                      Header="Name"
                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Name}"
                      ToggleType="Radio" />
            <MenuItem Command="{Binding SortExplorerCommand}"
                      CommandParameter="Date"
                      Header="Date modified"
                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Date}"
                      ToggleType="Radio" />
            <MenuItem Command="{Binding SortExplorerCommand}"
                      CommandParameter="Type"
                      Header="Type"
                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Type}"
                      ToggleType="Radio" />
            <MenuItem Command="{Binding SortExplorerCommand}"
                      CommandParameter="Size"
                      Header="Size"
                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Size}"
                      ToggleType="Radio" />
            <MenuItem Command="{Binding SortExplorerCommand}"
                      CommandParameter="Permissions"
                      Header="Permissions"
                      IsChecked="{Binding SortBy, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=Permissions}"
                      ToggleType="Radio" />
            <Separator />
            <MenuItem Command="{Binding SetSortDescendingCommand}"
                      CommandParameter="False"
                      Header="Ascending"
                      IsChecked="{Binding !SortDescending, Mode=OneWay}"
                      ToggleType="Radio" />
            <MenuItem Command="{Binding SetSortDescendingCommand}"
                      CommandParameter="True"
                      Header="Descending"
                      IsChecked="{Binding SortDescending, Mode=OneWay}"
                      ToggleType="Radio" />
        </MenuFlyout>
        <MenuFlyout x:Key="ViewMenu" Placement="BottomEdgeAlignedLeft">
            <MenuItem Command="{Binding SetExplorerViewModeCommand}"
                      CommandParameter="2"
                      Header="Large icons"
                      IsChecked="{Binding ExplorerViewMode, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=2}"
                      ToggleType="Radio" />
            <MenuItem Command="{Binding SetExplorerViewModeCommand}"
                      CommandParameter="1"
                      Header="List"
                      IsChecked="{Binding ExplorerViewMode, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"
                      ToggleType="Radio" />
            <MenuItem Command="{Binding SetExplorerViewModeCommand}"
                      CommandParameter="0"
                      Header="Details"
                      IsChecked="{Binding ExplorerViewMode, Mode=OneWay, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"
                      ToggleType="Radio" />
            <Separator />
            <MenuItem Command="{Binding ToggleHiddenFilesCommand}"
                      Header="Hidden items"
                      IsChecked="{Binding ShowHiddenFiles, Mode=OneWay}"
                      ToggleType="CheckBox" />
        </MenuFlyout>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.addressBar">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Border.addressBar:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ui|FABreadcrumbBar">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="DataGrid.explorer DataGridCell">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.cut">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="DataGridRow.dropInto">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <Style Selector="ListBoxItem.dropInto /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <Style Selector="TreeViewItem.dropInto">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
        <Style Selector="Border.dropTarget">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.dropTarget.active">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--  ═══ Navigation, address bar, search ═══  -->
        <Grid Grid.Row="0"
              Margin="8,8,8,4"
              ColumnDefinitions="Auto,*,240"
              ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tool"
                        Command="{Binding NavigateBackCommand}"
                        ToolTip.Tip="Back (Alt+Left)">
                    <PathIcon Data="{StaticResource arrow_left_regular}" />
                </Button>
                <Button Classes="tool"
                        Command="{Binding NavigateForwardCommand}"
                        ToolTip.Tip="Forward (Alt+Right)">
                    <PathIcon Data="{StaticResource arrow_right_regular}" />
                </Button>
                <Button Classes="tool"
                        Command="{Binding NavigateUpCommand}"
                        IsEnabled="{Binding IsConnected}"
                        ToolTip.Tip="Up to the parent folder (Alt+Up)">
                    <PathIcon Data="{StaticResource arrow_up_regular}" />
                </Button>
                <Button Classes="tool"
                        Command="{Binding RefreshDirectoryCommand}"
                        IsEnabled="{Binding IsConnected}"
                        ToolTip.Tip="Refresh (F5)">
                    <PathIcon Data="{StaticResource arrow_clockwise_regular}" />
                </Button>
            </StackPanel>

            <!--  Address: path segments; click the empty area (or Ctrl+L) to type a path  -->
            <Border x:Name="AddressBar"
                    Grid.Column="1"
                    Classes="addressBar"
                    IsEnabled="{Binding IsConnected}"
                    PointerPressed="OnAddressBarPressed">
                <Panel>
                    <ui:FABreadcrumbBar x:Name="Breadcrumb"
                                        Margin="4,0"
                                        ItemsSource="{Binding PathSegments}">
                        <ui:FABreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="models:PathSegment">
                                <ui:FABreadcrumbBarItem Content="{Binding}">
                                    <ui:FABreadcrumbBarItem.ContentTemplate>
                                        <DataTemplate x:DataType="models:PathSegment">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Width="14"
                                                          Height="14"
                                                          Data="{StaticResource server_regular}"
                                                          IsVisible="{Binding IsRoot}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ui:FABreadcrumbBarItem.ContentTemplate>
                                </ui:FABreadcrumbBarItem>
                            </DataTemplate>
                        </ui:FABreadcrumbBar.ItemTemplate>
                    </ui:FABreadcrumbBar>
                    <TextBox x:Name="PathBox"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             BorderThickness="0"
                             IsVisible="False"
                             KeyDown="OnPathKeyDown"
                             LostFocus="OnPathBoxLostFocus"
                             PlaceholderText="/path/to/directory"
                             Text="{Binding PathInput}" />
                </Panel>
            </Border>

            <TextBox x:Name="SearchBox"
                     Grid.Column="2"
                     VerticalContentAlignment="Center"
                     IsEnabled="{Binding IsConnected}"
                     PlaceholderText="{Binding CurrentFolderName, StringFormat='Search in {0}'}"
                     Text="{Binding ExplorerFilter}">
                <TextBox.InnerLeftContent>
                    <PathIcon Width="14"
                              Height="14"
                              Margin="10,0,0,0"
                              Data="{StaticResource search_regular}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>

        <!--  ═══ Command bar ═══  -->
        <ui:FACommandBar Grid.Row="1"
                         Margin="4,0,4,2"
                         DefaultLabelPosition="Right"
                         IsDynamicOverflowEnabled="True">
            <ui:FACommandBar.PrimaryCommands>
                <ui:FACommandBarButton Click="OnNewFolderClick"
                                       IconSource="{StaticResource folder_add_regular_icon}"
                                       IsEnabled="{Binding IsConnected}"
                                       Label="New folder" />
                <ui:FACommandBarButton Click="OnUploadClick"
                                       IconSource="{StaticResource arrow_upload_regular_icon}"
                                       IsEnabled="{Binding IsConnected}"
                                       Label="Upload"
                                       ToolTip.Tip="Upload files (or drop them onto the list)" />
                <ui:FACommandBarButton Command="{Binding DownloadCommand}"
                                       IconSource="{StaticResource arrow_download_regular_icon}"
                                       Label="Download"
                                       ToolTip.Tip="Download the selected files and folders" />
                <ui:FACommandBarSeparator />
                <ui:FACommandBarButton Command="{Binding CutCommand}"
                                       IconSource="{StaticResource cut_regular_icon}"
                                       Label="Cut"
                                       ToolTip.Tip="Cut (Ctrl+X)" />
                <ui:FACommandBarButton Command="{Binding CopyCommand}"
                                       IconSource="{StaticResource copy_regular_icon}"
                                       Label="Copy"
                                       ToolTip.Tip="Copy (Ctrl+C)" />
                <ui:FACommandBarButton Command="{Binding PasteCommand}"
                                       IconSource="{StaticResource clipboard_paste_regular_icon}"
                                       Label="Paste"
                                       ToolTip.Tip="Paste into this folder (Ctrl+V)" />
                <ui:FACommandBarButton Click="OnRenameClick"
                                       IconSource="{StaticResource rename_regular_icon}"
                                       IsEnabled="{Binding HasSingleSelection}"
                                       Label="Rename"
                                       ToolTip.Tip="Rename (F2)" />
                <ui:FACommandBarButton Command="{Binding DeleteCommand}"
                                       IconSource="{StaticResource delete_regular_icon}"
                                       Label="Delete"
                                       ToolTip.Tip="Delete (Del)" />
                <ui:FACommandBarButton Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowPermissionDialogCommand}"
                                       IconSource="{StaticResource lock_closed_regular_icon}"
                                       IsEnabled="{Binding HasSelection}"
                                       Label="Permissions" />
                <ui:FACommandBarSeparator />
                <ui:FACommandBarButton Click="OnSortClick"
                                       IconSource="{StaticResource arrow_sort_regular_icon}"
                                       Label="Sort" />
                <ui:FACommandBarButton Click="OnViewClick"
                                       IconSource="{StaticResource grid_regular_icon}"
                                       Label="View" />
            </ui:FACommandBar.PrimaryCommands>
            <ui:FACommandBar.SecondaryCommands>
                <ui:FACommandBarButton Click="OnMoveToClick"
                                       IconSource="{StaticResource folder_arrow_right_regular_icon}"
                                       IsEnabled="{Binding HasSelection}"
                                       Label="Move to…" />
                <ui:FACommandBarButton Click="OnCopyToClick"
                                       IconSource="{StaticResource copy_regular_icon}"
                                       IsEnabled="{Binding HasSelection}"
                                       Label="Copy to…" />
                <ui:FACommandBarButton Click="OnDownloadToClick"
                                       IconSource="{StaticResource arrow_download_regular_icon}"
                                       IsEnabled="{Binding HasSelection}"
                                       Label="Download to…" />
                <ui:FACommandBarSeparator />
                <ui:FACommandBarButton Click="OnSelectAllClick"
                                       IconSource="{StaticResource select_all_on_regular_icon}"
                                       IsEnabled="{Binding IsConnected}"
                                       Label="Select all" />
                <ui:FACommandBarButton Click="OnCopyPathClick"
                                       IconSource="{StaticResource document_copy_regular_icon}"
                                       IsEnabled="{Binding HasSelection}"
                                       Label="Copy path" />
            </ui:FACommandBar.SecondaryCommands>
        </ui:FACommandBar>

        <!--  ═══ Navigation pane + file list ═══  -->
        <Grid Grid.Row="2"
              Margin="0,4,0,0"
              ColumnDefinitions="230,Auto,*">

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Button Grid.Row="0"
                            Margin="4,4,4,0"
                            Classes="navItem"
                            Command="{Binding NavigateHomeCommand}"
                            IsEnabled="{Binding IsConnected}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Classes="small"
                                      Data="{StaticResource home_regular}"
                                      Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Home" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="1"
                            Height="1"
                            Margin="10,4"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding RootNodes}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                              SelectionMode="Single">
                        <TreeView.Styles>
                            <Style x:DataType="models:DirectoryNode" Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="MinHeight" Value="28" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="models:DirectoryNode" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Classes="fileIcon" Source="{Binding Converter={StaticResource FileIconConverter}}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                          ResizeDirection="Columns" />

            <!--  File pane  -->
            <Panel x:Name="FilePane" Grid.Column="2">

                <!--  Disconnected info  -->
                <ui:FAInfoBar Margin="8"
                              VerticalAlignment="Top"
                              IsClosable="False"
                              IsOpen="{Binding !IsConnected}"
                              Message="{Binding FileExplorerStatus}"
                              Severity="Informational" />

                <!--  Details view  -->
                <DataGrid x:Name="DetailsGrid"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          Classes="explorer"
                          DoubleTapped="OnFileDoubleTapped"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          IsVisible="{Binding ExplorerViewMode, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"
                          ItemsSource="{Binding RemoteFiles}"
                          KeyDown="OnFileKeyDown"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Extended"
                          Sorting="OnDetailsSorting"
                          Tapped="OnFileTapped">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*"
                                                MinWidth="200"
                                                Header="Name"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tm:RemoteFile">
                                    <StackPanel Margin="10,0,0,0"
                                                Classes.cut="{Binding IsCut}"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                        <Image Classes="fileIcon" Source="{Binding Converter={StaticResource FileIconConverter}}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="150"
                                                Header="Date modified"
                                                SortMemberPath="LastModified">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tm:RemoteFile">
                                    <TextBlock Margin="12,0"
                                               Classes="secondary"
                                               IsVisible="{Binding !IsParentLink}"
                                               Text="{Binding LastModified, StringFormat='{}{0:g}'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="150"
                                                Header="Type"
                                                SortMemberPath="Extension">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tm:RemoteFile">
                                    <TextBlock Margin="12,0"
                                               Classes="secondary"
                                               Text="{Binding Converter={StaticResource FileTypeConverter}}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="90"
                                                Header="Size"
                                                SortMemberPath="Size">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tm:RemoteFile">
                                    <TextBlock Margin="12,0"
                                               HorizontalAlignment="Right"
                                               Classes="secondary"
                                               Text="{Binding SizeDisplay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="110"
                                                Header="Permissions"
                                                SortMemberPath="Permissions">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="tm:RemoteFile">
                                    <TextBlock Margin="12,0"
                                               Classes="secondary"
                                               IsVisible="{Binding !IsParentLink}"
                                               Text="{Binding PermissionsDisplay}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  List view  -->
                <ListBox x:Name="ListView"
                         Background="Transparent"
                         DoubleTapped="OnFileDoubleTapped"
                         IsVisible="{Binding ExplorerViewMode, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"
                         ItemsSource="{Binding RemoteFiles}"
                         KeyDown="OnFileKeyDown"
                         SelectionMode="Multiple"
                         Tapped="OnFileTapped">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,3" />
                            <Setter Property="MinHeight" Value="28" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="tm:RemoteFile">
                            <StackPanel Classes.cut="{Binding IsCut}"
                                        Orientation="Horizontal"
                                        Spacing="10">
                                <Image Classes="fileIcon" Source="{Binding Converter={StaticResource FileIconConverter}}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  Large icons view  -->
                <ListBox x:Name="IconsView"
                         Background="Transparent"
                         DoubleTapped="OnFileDoubleTapped"
                         IsVisible="{Binding ExplorerViewMode, Converter={StaticResource EqualsConverter}, ConverterParameter=2}"
                         ItemsSource="{Binding RemoteFiles}"
                         KeyDown="OnFileKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Multiple"
                         Tapped="OnFileTapped">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="tm:RemoteFile">
                            <StackPanel Width="96"
                                        Margin="0,8"
                                        Classes.cut="{Binding IsCut}"
                                        Spacing="6">
                                <Image Width="48"
                                       Height="48"
                                       HorizontalAlignment="Center"
                                       Source="{Binding Converter={StaticResource FileIconConverter}, ConverterParameter=48}" />
                                <TextBlock FontSize="11"
                                           MaxLines="2"
                                           Text="{Binding Name}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--  Empty folder  -->
                <TextBlock Margin="0,64,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Classes="secondary"
                           IsHitTestVisible="False"
                           IsVisible="{Binding IsFolderEmpty}"
                           Text="This folder is empty." />

                <!--  Drag and drop: frame around the list + what a drop will do ("Upload to …", "Move 3 items to …")  -->
                <Border x:Name="DropTarget"
                        Margin="4"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="2"
                        Classes="dropTarget"
                        CornerRadius="6"
                        IsHitTestVisible="False">
                    <Border Margin="0,0,0,16"
                            Padding="14,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon x:Name="DropTargetIcon"
                                      Width="14"
                                      Height="14"
                                      Data="{StaticResource arrow_upload_regular}"
                                      Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DropTargetText"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Panel>
        </Grid>

        <!--  ═══ Status bar ═══  -->
        <Grid Grid.Row="3"
              Margin="12,2,6,2"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="16">
            <TextBlock Classes="secondary" Text="{Binding ExplorerSummary}" />
            <TextBlock Grid.Column="1"
                       Classes="secondary"
                       Text="{Binding SelectionSummary}" />
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="2">
                <Button Width="26"
                        Height="24"
                        Classes="tool"
                        Classes.active="{Binding ExplorerViewMode, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"
                        Command="{Binding SetExplorerViewModeCommand}"
                        CommandParameter="0"
                        ToolTip.Tip="Details">
                    <PathIcon Data="{StaticResource text_bullet_list_regular}" />
                </Button>
                <Button Width="26"
                        Height="24"
                        Classes="tool"
                        Classes.active="{Binding ExplorerViewMode, Converter={StaticResource EqualsConverter}, ConverterParameter=2}"
                        Command="{Binding SetExplorerViewModeCommand}"
                        CommandParameter="2"
                        ToolTip.Tip="Large icons">
                    <PathIcon Data="{StaticResource grid_regular}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
