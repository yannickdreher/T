<UserControl x:Class="T.UI.Views.Components.SystemMonitorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:T.UI.ViewModels"
             d:DesignHeight="28"
             d:DesignWidth="800"
             x:DataType="vm:SystemMonitorViewModel"
             IsVisible="{Binding IsAvailable}"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:SystemMonitorViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.metricLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.metric">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="5" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="14">

        <!--  CPU  -->
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    ToolTip.Tip="Remote CPU usage">
            <TextBlock Classes="metricLabel" Text="CPU" />
            <ProgressBar Classes="metric" Value="{Binding CpuPercent}" />
            <TextBlock MinWidth="32"
                       Classes="metricValue"
                       Text="{Binding CpuPercent, StringFormat='{}{0:0}%'}" />
        </StackPanel>

        <!--  RAM  -->
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    ToolTip.Tip="{Binding RamDisplay}">
            <TextBlock Classes="metricLabel" Text="RAM" />
            <ProgressBar Classes="metric" Value="{Binding RamPercent}" />
            <TextBlock MinWidth="32"
                       Classes="metricValue"
                       Text="{Binding RamPercent, StringFormat='{}{0:0}%'}" />
        </StackPanel>

        <!--  Network  -->
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    ToolTip.Tip="Remote network throughput">
            <TextBlock Classes="metricLabel" Text="NET" />
            <TextBlock Classes="metricValue" Foreground="{DynamicResource SystemFillColorSuccessBrush}">
                <Run Text="↓" /><Run Text="{Binding NetworkDownDisplay}" />
            </TextBlock>
            <TextBlock Classes="metricValue" Foreground="{DynamicResource SystemFillColorCautionBrush}">
                <Run Text="↑" /><Run Text="{Binding NetworkUpDisplay}" />
            </TextBlock>
        </StackPanel>

        <!--  Disk  -->
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    ToolTip.Tip="{Binding DiskDisplay}">
            <TextBlock Classes="metricLabel" Text="DISK" />
            <ProgressBar Classes="metric" Value="{Binding DiskPercent}" />
            <TextBlock MinWidth="32"
                       Classes="metricValue"
                       Text="{Binding DiskPercent, StringFormat='{}{0:0}%'}" />
        </StackPanel>
    </StackPanel>
</UserControl>
