<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:T.UI.ViewModels"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d" d:DesignWidth="800"
			 x:Class="T.UI.Views.Components.SessionStatusBarView"
			 x:DataType="vm:SessionViewModel">

	<Border Background="{DynamicResource LayerFillColorDefaultBrush}"
			BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
			CornerRadius="0,4"
			BorderThickness="0,1,0,0">
		<Grid ColumnDefinitions="Auto,*,Auto"  ColumnSpacing="4">
			<Border Grid.Column="0"
					Padding="2"
					BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
					BorderThickness="0,0,1,0">
				<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
					<PathIcon Width="12"
							  Height="12"
							  IsVisible="{Binding Session.IsConnected}"
							  Data="{StaticResource plug_connected_checkmark_regular}"
							  Foreground="{Binding Session.ConnectionStatus, Converter={StaticResource ConnectionStatusBrushConverter}}"/>

					<PathIcon Width="12"
							  Height="12"
							  IsVisible="{Binding !Session.IsConnected}"
							  Data="{StaticResource plug_disconnected_regular}"
							  Foreground="{Binding Session.ConnectionStatus, Converter={StaticResource ConnectionStatusBrushConverter}}"/>

					<TextBlock Text="{Binding Session.ConnectionStatus, FallbackValue='Disconnected'}"
							   FontSize="12"
							   VerticalAlignment="Center"/>
				</StackPanel>
			</Border>

			<Border Grid.Column="1"
					Padding="2"
					BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
					BorderThickness="0,0,1,0">
				<StackPanel Orientation="Horizontal"
							Spacing="8"
							HorizontalAlignment="Right"
							VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal"
								Spacing="8"
								IsVisible="{Binding IsTransferring, FallbackValue=False}"
								VerticalAlignment="Center">
						<TextBlock Text="{Binding TransferDirection}"
								   Foreground="White"
								   FontSize="12"/>
						<TextBlock Text="{Binding TransferFileName}"
								   FontSize="12"
								   MaxWidth="150"
								   TextTrimming="CharacterEllipsis"/>
						<ProgressBar Value="{Binding TransferProgress}"
									 Maximum="100"
									 Width="150"
									 FontSize="12"
									 VerticalAlignment="Center"/>
						<TextBlock Text="{Binding TransferProgress, StringFormat={}{0:F0}%}"
								   Width="35"
								   FontSize="12"/>
						<TextBlock Text="{Binding TransferSpeed}"
								   Opacity="0.8"
								   Width="80"
								   FontSize="12"/>
						<TextBlock Text="{Binding TransferEta, StringFormat=ETA {0}}"
								   Opacity="0.8"
								   FontSize="12"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Grid.Column="2" Padding="2">
				<Button Command="{Binding ToggleTerminalStatsOverlayCommand}"
						Width="24"
						Height="20"
						Padding="2"
						FontSize="12">
					<PathIcon Width="12"
							  Height="12"
							  Data="{StaticResource bug_regular}"/>
				</Button>
			</Border>
		</Grid>
	</Border>
</UserControl>