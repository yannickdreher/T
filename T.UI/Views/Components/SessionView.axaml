<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:T.UI.ViewModels"
			 xmlns:components="using:T.UI.Views.Components"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
			 x:Class="T.UI.Views.Components.SessionView"
			 x:DataType="vm:SessionViewModel">

	<Design.DataContext>
		<vm:SessionViewModel/>
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="TabStrip.sessionTabs">
			<Setter Property="Margin" Value="4,2"/>
		</Style>
		<Style Selector="TabStrip.sessionTabs TabStripItem">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="MinHeight" Value="30"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="Margin" Value="0,0,4,0"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="TabStrip.sessionTabs TabStripItem PathIcon">
			<Setter Property="Width" Value="14"/>
			<Setter Property="Height" Value="14"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*,Auto">

		<!-- Terminal / Explorer tab strip -->
		<Border Grid.Row="0"
				Background="{DynamicResource LayerFillColorDefaultBrush}"
				BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
				BorderThickness="0,0,0,1">
			<TabStrip Classes="sessionTabs"
					  SelectedIndex="{Binding SelectedSessionTab, Mode=TwoWay}">
				<TabStripItem>
					<StackPanel Orientation="Horizontal" Spacing="6">
						<PathIcon Data="{StaticResource window_console_regular}"/>
						<TextBlock Text="Terminal" VerticalAlignment="Center"/>
					</StackPanel>
				</TabStripItem>
				<TabStripItem>
					<StackPanel Orientation="Horizontal" Spacing="6">
						<PathIcon Data="{StaticResource folder_regular}"/>
						<TextBlock Text="Explorer" VerticalAlignment="Center"/>
					</StackPanel>
				</TabStripItem>
			</TabStrip>
		</Border>

		<!-- Tab content: panels stay attached, visibility is toggled so the
			 terminal keeps its session and scroll state across switches -->
		<Panel Grid.Row="1">
			<ContentControl x:Name="TerminalHost"
							IsVisible="{Binding SelectedSessionTab, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"/>
			<components:SftpExplorerView IsVisible="{Binding SelectedSessionTab, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"/>
		</Panel>

		<!-- Status Bar / Footer -->
		<components:SessionStatusBarView Grid.Row="2"/>

		<!-- Connection Overlay -->
		<Border Grid.RowSpan="3"
				IsVisible="{Binding ShowOverlay, FallbackValue=False}"
				Background="#DD000000"
				IsHitTestVisible="True">
			<StackPanel HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="20">
				<ProgressBar IsIndeterminate="True" Width="240"/>
				<TextBlock Text="{Binding OverlayMessage}"
						   Foreground="White"
						   TextAlignment="Center"
						   HorizontalAlignment="Center"/>
				<Button Content="Cancel"
						Command="{Binding CancelReconnectCommand}"
						HorizontalAlignment="Center"
						Classes="accent"
						Padding="24,8"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>