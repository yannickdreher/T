<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:T.UI.ViewModels"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="600"
			 x:Class="T.UI.Views.Components.FileExplorer"
			 x:DataType="vm:SessionViewModel"
			 Margin="4">

	<Design.DataContext>
		<vm:SessionViewModel/>
	</Design.DataContext>

	<Grid RowDefinitions="Auto,Auto,*" RowSpacing="5">
		<TextBox Text="{Binding CurrentPath}" IsReadOnly="True"/>

		<Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
			<Button Grid.Column="0"
					Command="{Binding RefreshDirectoryCommand}"
					ToolTip.Tip="Refresh"
					IsEnabled="{Binding IsConnected}"
					MinWidth="32"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center">
				<PathIcon Data="{StaticResource arrow_sync_regular}" Width="14" Height="14"/>
			</Button>

			<Button Grid.Column="1"
					Command="{Binding DownloadFileCommand}"
					ToolTip.Tip="Download"
					IsEnabled="{Binding IsConnected}"
					MinWidth="32"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center">
				<PathIcon Data="{StaticResource document_arrow_down_regular}" Width="14" Height="14"/>
			</Button>

			<Button Grid.Column="2"
					Click="OnUploadClick"
					ToolTip.Tip="Upload"
					IsEnabled="{Binding IsConnected}"
					MinWidth="32"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center">
				<PathIcon Data="{StaticResource document_arrow_up_regular}" Width="14" Height="14"/>
			</Button>

			<Button Grid.Column="3"
					Command="{Binding DeleteFileCommand}"
					ToolTip.Tip="Delete"
					IsEnabled="{Binding IsConnected}"
					MinWidth="32"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center">
				<PathIcon Data="{StaticResource delete_regular}" Width="14" Height="14"/>
			</Button>

			<Button Grid.Column="4"
					Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowPermissionDialogCommand}"
					ToolTip.Tip="Permissions"
					MinWidth="32"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Center">
				<PathIcon Data="{StaticResource key_regular}" Width="14" Height="14"/>
			</Button>
		</Grid>

		<!-- Status InfoBar -->
		<ui:InfoBar Grid.Row="2"
					IsOpen="{Binding !IsConnected}"
					IsClosable="False"
					Severity="Informational"
					Message="{Binding FileExplorerStatus}"/>

		<DataGrid Grid.Row="2" ItemsSource="{Binding RemoteFiles}"
				  SelectedItem="{Binding SelectedFile}"
				  AutoGenerateColumns="False"
				  CanUserReorderColumns="True"
				  CanUserResizeColumns="True"
				  IsReadOnly="True"
				  GridLinesVisibility="None"
				  HeadersVisibility="Column"
				  DoubleTapped="OnFileDoubleTapped"
				  VerticalAlignment="Stretch"
				  ScrollViewer.VerticalScrollBarVisibility="Auto"
				  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
			<DataGrid.Columns>
				<DataGridTemplateColumn Header="" Width="40">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<PathIcon Data="{Binding IconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
									  Foreground="{Binding IconColor}"
									  Width="14"
									  Height="14"
									  HorizontalAlignment="Center"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="124"/>
				<DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80" MinWidth="80"/>
				<DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="60" MinWidth="60"/>
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>