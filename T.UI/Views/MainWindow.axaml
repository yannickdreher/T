<wnd:FAAppWindow x:Class="T.UI.Views.MainWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:components="using:T.UI.Views.Components"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:svg="using:Avalonia.Svg.Skia"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:vm="using:T.UI.ViewModels"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 Title="T"
                 Width="1200"
                 Height="700"
                 d:DesignHeight="700"
                 d:DesignWidth="1200"
                 x:DataType="vm:MainWindowViewModel"
                 FontSize="12"
                 Icon="avares://T/Assets/logo.ico"
                 RenderOptions.BitmapInterpolationMode="HighQuality"
                 WindowState="Maximized"
                 mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid Margin="8,0,8,8" RowDefinitions="32,*">

        <!--  Title bar: logo + menu (the window extends its content into the title bar)  -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
            <Image Width="20"
                   Height="20"
                   Source="avares://T/Assets/logo.ico" />
            <Menu VerticalAlignment="Center">
                <Menu.Styles>
                    <Style Selector="MenuItem">
                        <Setter Property="Height" Value="26" />
                        <Setter Property="Padding" Value="8,2" />
                    </Style>
                </Menu.Styles>
                <MenuItem Command="{Binding ShowSettingsCommand}" Header="Settings" />
                <MenuItem Command="{Binding ShowAboutCommand}" Header="About" />
            </Menu>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="300,Auto,*">
            <!--  Sidebar: saved sessions  -->
            <components:SessionsPanel Grid.Column="0" DataContext="{Binding SessionsTree}" />

            <GridSplitter Grid.Column="1"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Panel Grid.Column="2">
                <!--
                    Session tabs. The strip lies on the window background; the selected tab merges into
                    the session surface below it (SessionView). SessionViewCache keeps one SessionView per
                    session so the live terminal survives tab switches.
                -->
                <ui:FATabView x:Name="SessionTabs"
                              CanReorderTabs="True"
                              CloseButtonOverlayMode="OnPointerOver"
                              IsAddTabButtonVisible="True"
                              IsVisible="{Binding SessionsTree.HasOpenSessions}"
                              SelectedItem="{Binding SessionsTree.ActiveSession}"
                              TabItemsSource="{Binding SessionsTree.OpenSessions}"
                              TabWidthMode="SizeToContent">
                    <ui:FATabView.TabStripFooter>
                        <!--  Terminal / file explorer of the active session  -->
                        <ListBox Margin="12,0,2,4"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center"
                                 Classes="segmented"
                                 SelectedIndex="{Binding SessionsTree.ActiveSession.SelectedSessionTab, Mode=TwoWay, FallbackValue=0}"
                                 Theme="{StaticResource SegmentedTheme}">
                            <ListBoxItem ToolTip.Tip="Terminal">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Classes="small" Data="{StaticResource window_console_regular}" />
                                    <TextBlock VerticalAlignment="Center" Text="Terminal" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem ToolTip.Tip="SFTP file explorer">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Classes="small" Data="{StaticResource folder_open_regular}" />
                                    <TextBlock VerticalAlignment="Center" Text="Files" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </ui:FATabView.TabStripFooter>
                    <ui:FATabView.TabItemTemplate>
                        <DataTemplate x:DataType="vm:SessionViewModel">
                            <ui:FATabViewItem Content="{Binding}" ToolTip.Tip="{Binding Session.Address}">
                                <ui:FATabViewItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Classes="status"
                                                 Classes.busy="{Binding IsBusy}"
                                                 Classes.connected="{Binding IsConnected}"
                                                 Classes.error="{Binding HasConnectionError}" />
                                        <TextBlock MaxWidth="220"
                                                   Text="{Binding TabTitle}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </ui:FATabViewItem.Header>
                            </ui:FATabViewItem>
                        </DataTemplate>
                    </ui:FATabView.TabItemTemplate>
                </ui:FATabView>

                <!--  Welcome screen (no session open)  -->
                <Border Classes="Panel" IsVisible="{Binding !SessionsTree.HasOpenSessions}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <svg:Svg Width="120"
                                 Height="120"
                                 Margin="0,0,0,8"
                                 Path="/Assets/logo.svg" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Text="Welcome" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Double-click a session in the sidebar to connect, or create a new one." />
                        <Button Margin="0,8,0,0"
                                Padding="16,6"
                                HorizontalAlignment="Center"
                                Classes="accent"
                                Command="{Binding SessionsTree.NewSessionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Classes="small" Data="{StaticResource plug_connected_add_regular}" />
                                <TextBlock Text="New session" />
                            </StackPanel>
                        </Button>
                        <Border Margin="0,16,0,0"
                                Padding="16,10"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="small file" Data="{StaticResource window_console_regular}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Terminal with remote system monitor" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="small file" Data="{StaticResource folder_regular}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="SFTP explorer with drag and drop upload" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="small file" Data="{StaticResource key_regular}" />
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Keys, jump hosts and known_hosts shared with OpenSSH" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>
    </Grid>
</wnd:FAAppWindow>
