<wnd:FAAppWindow x:Class="T.UI.Views.SettingsWindow"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dialogs="using:T.UI.Views.Dialogs"
                 xmlns:vm="using:T.UI.ViewModels"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 Title="Settings"
                 Width="600"
                 Height="560"
                 MinWidth="600"
                 x:DataType="vm:SettingsDialogViewModel"
                 WindowStartupLocation="CenterOwner">

    <Grid Margin="8"
          RowDefinitions="*,Auto"
          RowSpacing="8">
        <dialogs:SettingsDialog Grid.Row="0" />

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button MinWidth="120"
                    Classes="accent"
                    Click="OnSaveClick"
                    Content="Save"
                    IsEnabled="{Binding HasAnyErrors, Converter={StaticResource BoolNegationConverter}}" />
            <Button MinWidth="120"
                    Click="OnCancelClick"
                    Content="Cancel" />
        </StackPanel>
    </Grid>
</wnd:FAAppWindow>