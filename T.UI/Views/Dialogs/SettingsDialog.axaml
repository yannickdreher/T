<UserControl x:Class="T.UI.Views.Dialogs.SettingsDialog"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="using:System"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:T.UI.ViewModels"
             d:DesignHeight="500"
             d:DesignWidth="600"
             x:DataType="vm:SettingsDialogViewModel"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:SettingsDialogViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="160,*" ColumnSpacing="4">

        <!--  Navigation  -->
        <ListBox x:Name="SettingsNav"
                 Padding="0"
                 Background="Transparent"
                 BorderThickness="0"
                 CornerRadius="6"
                 SelectedIndex="0">
            <ListBoxItem Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14"
                              Height="14"
                              Data="{StaticResource settings_regular}" />
                    <TextBlock Text="General" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14"
                              Height="14"
                              Data="{StaticResource folder_regular}" />
                    <TextBlock Text="Explorer" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14"
                              Height="14"
                              Data="{StaticResource window_console_regular}" />
                    <TextBlock Text="Terminal" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="14"
                              Height="14"
                              Data="{StaticResource key_regular}" />
                    <TextBlock Text="step-ca" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!--  Pages  -->
        <Border Grid.Column="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}">
            <ScrollViewer Padding="0,0,6,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Panel Margin="8">
                    <!--  Page: General  -->
                    <StackPanel IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Theme" />
                            <ComboBox x:Name="ThemeCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding General.Theme}">
                                <sys:String>System</sys:String>
                                <sys:String>Light</sys:String>
                                <sys:String>Dark</sys:String>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Language" />
                            <ComboBox x:Name="LanguageCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding General.Language}">
                                <sys:String>System</sys:String>
                                <sys:String>English</sys:String>
                                <sys:String>Deutsch</sys:String>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Connection timeout (seconds)" />
                            <NumericUpDown x:Name="ConnectionTimeoutInput"
                                           HorizontalAlignment="Stretch"
                                           Maximum="120"
                                           Minimum="5"
                                           Value="{Binding General.ConnectionTimeout}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Keep-alive interval (seconds)" />
                            <NumericUpDown x:Name="KeepAliveIntervalInput"
                                           HorizontalAlignment="Stretch"
                                           Maximum="120"
                                           Minimum="10"
                                           Value="{Binding General.KeepAliveInterval}" />
                        </StackPanel>

                        <CheckBox Content="Confirm before closing window" IsChecked="{Binding General.ConfirmOnClose}" />

                        <CheckBox Content="Reopen sessions that were open on last exit" IsChecked="{Binding General.ReconnectOnStartup}" />

                        <CheckBox Content="Use default SSH keys (~/.ssh/id_ed25519, id_ecdsa, id_rsa) when a session has no key" IsChecked="{Binding General.UseDefaultIdentityFiles}" />

                        <Separator Margin="0,8" />

                        <TextBlock Margin="0,4,0,0"
                                   FontWeight="SemiBold"
                                   Text="Updates" />

                        <CheckBox Content="Check for updates on startup" IsChecked="{Binding Update.CheckForUpdatesOnStartup}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Update Channel" />
                            <ComboBox x:Name="UpdateChannelCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding Update.UpdateChannel}">
                                <sys:String>Stable</sys:String>
                                <sys:String>Beta</sys:String>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!--  Page: Explorer  -->
                    <StackPanel IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}" Spacing="8">
                        <CheckBox Content="Show hidden files" IsChecked="{Binding Explorer.ShowHiddenFiles}" />

                        <CheckBox Content="Confirm before deleting files" IsChecked="{Binding Explorer.ConfirmDelete}" />

                        <CheckBox Content="Open directories with double-click (otherwise single click)" IsChecked="{Binding Explorer.DoubleClickToOpen}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Sort files by" />
                            <ComboBox x:Name="SortByCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding Explorer.SortBy}">
                                <sys:String>Name</sys:String>
                                <sys:String>Size</sys:String>
                                <sys:String>Date</sys:String>
                                <sys:String>Type</sys:String>
                                <sys:String>Permissions</sys:String>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Default download path" />
                            <TextBox x:Name="DefaultDownloadPathBox"
                                     PlaceholderText="Leave empty for ~/Downloads"
                                     Text="{Binding Explorer.DefaultDownloadPath}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Page: Terminal  -->
                    <StackPanel IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=2}" Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Font family" />
                            <ComboBox x:Name="TerminalFontFamilyCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding Terminal.TerminalFontFamily}">
                                <sys:String>Consolas</sys:String>
                                <sys:String>Cascadia Mono</sys:String>
                                <sys:String>JetBrains Mono</sys:String>
                                <sys:String>Fira Code</sys:String>
                                <sys:String>Source Code Pro</sys:String>
                                <sys:String>Courier New</sys:String>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Font size" />
                            <NumericUpDown x:Name="TerminalFontSizeInput"
                                           HorizontalAlignment="Stretch"
                                           Maximum="32"
                                           Minimum="8"
                                           Value="{Binding Terminal.TerminalFontSize}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Cursor style" />
                            <ComboBox x:Name="CursorStyleCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedItem="{Binding Terminal.CursorStyle}">
                                <sys:String>Bar</sys:String>
                                <sys:String>Block</sys:String>
                                <sys:String>Underline</sys:String>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Content="Cursor blinking" IsChecked="{Binding Terminal.CursorBlink}" />

                        <CheckBox Content="Enable terminal colors" IsChecked="{Binding Terminal.EnableTerminalColors}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Background color" />
                                <TextBox x:Name="TerminalBackgroundBox"
                                         HorizontalAlignment="Stretch"
                                         MaxLength="7"
                                         Text="{Binding Terminal.TerminalBackground}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Foreground color" />
                                <TextBox x:Name="TerminalForegroundBox"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding Terminal.TerminalForeground}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Cursor color" />
                            <TextBox x:Name="CursorColorBox"
                                     HorizontalAlignment="Stretch"
                                     Text="{Binding Terminal.CursorColor}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Scrollback lines" />
                            <NumericUpDown x:Name="ScrollbackLinesInput"
                                           HorizontalAlignment="Stretch"
                                           Increment="1000"
                                           Maximum="100000"
                                           Minimum="1000"
                                           Value="{Binding Terminal.ScrollbackLines}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Terminal padding (px)" />
                            <NumericUpDown x:Name="TerminalPaddingInput"
                                           HorizontalAlignment="Stretch"
                                           Maximum="32"
                                           Minimum="0"
                                           Value="{Binding Terminal.TerminalPadding}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Page: step-ca  -->
                    <StackPanel IsVisible="{Binding #SettingsNav.SelectedIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=3}" Spacing="8">
                        <TextBlock Classes="hint"
                                   Text="Sessions can log in with a short-lived SSH certificate from a step-ca. T creates the key pair itself and lets the step CLI sign only the public key. The private key is stored encrypted and never leaves T."
                                   TextWrapping="Wrap" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="step CLI" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <TextBox Grid.Column="0"
                                         PlaceholderText="Leave empty to search PATH"
                                         Text="{Binding Step.ExecutablePath}" />
                                <Button Grid.Column="1"
                                        Click="OnBrowseStepExecutable"
                                        Content="Browse..." />
                            </Grid>
                            <TextBlock Classes="hint"
                                       Text="{Binding Step.ExecutableStatus}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Separator Margin="0,8" />

                        <TextBlock FontWeight="SemiBold" Text="Certificate authorities" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ListBox Grid.Column="0"
                                     MinHeight="64"
                                     MaxHeight="120"
                                     ItemsSource="{Binding Step.Profiles}"
                                     SelectedItem="{Binding Step.SelectedProfile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StepProfileViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <Button HorizontalAlignment="Stretch"
                                        Command="{Binding Step.AddProfileCommand}"
                                        Content="Add" />
                                <Button HorizontalAlignment="Stretch"
                                        Command="{Binding Step.RemoveProfileCommand}"
                                        Content="Remove" />
                            </StackPanel>
                        </Grid>

                        <ContentControl Content="{Binding Step.SelectedProfile}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:StepProfileViewModel">
                                    <StackPanel Spacing="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Name" />
                                            <TextBox Text="{Binding Name}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Identity" />
                                            <TextBox PlaceholderText="e.g. you@example.com (the OIDC login)" Text="{Binding Identity}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="CA URL (optional)" />
                                            <TextBox PlaceholderText="https://ca.example.com" Text="{Binding CaUrl}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Root certificate (optional)" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                <TextBox Grid.Column="0"
                                                         PlaceholderText="root_ca.crt of the CA"
                                                         Text="{Binding RootCertificatePath}" />
                                                <Button Grid.Column="1"
                                                        Click="OnBrowseRootCertificate"
                                                        Content="Browse..." />
                                            </Grid>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Context (optional)" />
                                                <TextBox Text="{Binding Context}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Provisioner (optional)" />
                                                <TextBox Text="{Binding Provisioner}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Principals (optional)" />
                                            <TextBox PlaceholderText="Comma separated, e.g. alice, admin" Text="{Binding Principals}" />
                                        </StackPanel>
                                        <TextBlock Classes="hint"
                                                   Text="Empty fields use the configuration of the step CLI (step ca bootstrap). The CA must allow the login without questions on the command line: an OIDC provisioner (browser login) works, a password-protected JWK provisioner does not."
                                                   TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CertificateStatus}"
                                                       TextWrapping="Wrap" />
                                            <Button Grid.Column="1"
                                                    Command="{Binding DeleteCertificateCommand}"
                                                    Content="Delete certificate" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>