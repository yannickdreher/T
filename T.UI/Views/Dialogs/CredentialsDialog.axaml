<UserControl x:Class="T.UI.Views.Dialogs.CredentialsDialog"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:T.UI.ViewModels"
             x:DataType="vm:CredentialsDialogViewModel">

    <StackPanel Width="440" Spacing="8">
        <ui:FAInfoBar Title="Authentication failed"
                      IsClosable="False"
                      IsOpen="{Binding HasError}"
                      Message="{Binding ErrorMessage}"
                      Severity="Error" />

        <TextBlock Classes="hint" Text="{Binding Hostname, StringFormat='Log in to {0}'}" />

        <TextBox PlaceholderText="User name" Text="{Binding Username}" />
        <TextBox Classes="revealPasswordButton"
                 PasswordChar="●"
                 PlaceholderText="Password (optional when using a key)"
                 Text="{Binding Password}" />

        <TextBlock Classes="sectionHeader" Text="Private key (optional)" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <TextBox Grid.Column="0"
                     PlaceholderText="Private key file"
                     Text="{Binding PrivateKeyPath}" />
            <Button Grid.Column="1"
                    Command="{Binding BrowsePrivateKeyCommand}"
                    Content="Browse..." />
        </Grid>
        <TextBox Classes="revealPasswordButton"
                 IsEnabled="{Binding HasPrivateKey}"
                 PasswordChar="●"
                 PlaceholderText="Key passphrase (if the key is encrypted)"
                 Text="{Binding PrivateKeyPassword}" />

        <CheckBox Margin="0,4,0,0"
                  Content="Save credentials for this session"
                  IsChecked="{Binding SaveCredentials}" />
    </StackPanel>
</UserControl>
