<UserControl x:Class="T.UI.Views.Dialogs.TunnelEditorDialog"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:T.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:T.UI.ViewModels"
             x:DataType="vm:TunnelEditorViewModel"
             mc:Ignorable="d">

    <Design.DataContext>
        <vm:TunnelEditorViewModel />
    </Design.DataContext>

    <StackPanel Width="460" Spacing="8">
        <!--  Validation error (set by the owner when "Save" is clicked with invalid input)  -->
        <ui:FAInfoBar x:Name="ValidationInfo"
                      IsClosable="False"
                      IsOpen="False"
                      IsVisible="False"
                      Severity="Error" />

        <TextBox PlaceholderText="Name (defaults to the target)" Text="{Binding Name}" />

        <TextBlock Classes="sectionHeader" Text="SSH server" />
        <ComboBox HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Terminal profile"
                  IsEnabled="{Binding HasProfiles}"
                  ItemsSource="{Binding Profiles}"
                  PlaceholderText="Terminal profile"
                  SelectedItem="{Binding Profile}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:SshSession">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Address}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="hint" Text="The tunnel connects with the profile's settings: password, keys, step-ca certificate and jump hosts. Changes to the profile apply to the tunnel as well." />

        <TextBlock Classes="sectionHeader" Text="Forwarding" />
        <Grid ColumnDefinitions="72,*,110"
              ColumnSpacing="8"
              RowDefinitions="Auto,Auto"
              RowSpacing="8">
            <!--  The listener always binds to 127.0.0.1: only the port is a choice  -->
            <TextBlock VerticalAlignment="Center" Text="Local port" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Classes="hint"
                       Text="on this computer only (127.0.0.1)" />
            <ui:FANumberBox Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Local port"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            ToolTip.Tip="Local port"
                            Value="{Binding LocalPort}" />

            <!--  Target: as seen from the SSH server  -->
            <TextBlock Grid.Row="1"
                       VerticalAlignment="Center"
                       Text="Target" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     AutomationProperties.Name="Target host"
                     PlaceholderText="Target host"
                     Text="{Binding TargetHost}" />
            <ui:FANumberBox Grid.Row="1"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Target port"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            ToolTip.Tip="Target port"
                            Value="{Binding TargetPort}" />
        </Grid>
        <TextBlock Classes="hint" Text="The target is resolved by the SSH server: localhost is the server itself." />
    </StackPanel>
</UserControl>
