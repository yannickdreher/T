<UserControl x:Class="T.UI.Views.Dialogs.HostKeyDialog"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:T.UI.ViewModels"
             x:DataType="vm:HostKeyDialogViewModel">

    <StackPanel Width="500" Spacing="16">
        <!--  First connection  -->
        <ui:FAInfoBar Title="{Binding WarningTitle}"
                      IsClosable="False"
                      IsOpen="{Binding !IsKeyChanged}"
                      IsVisible="{Binding !IsKeyChanged}"
                      Message="{Binding WarningMessage}"
                      Severity="Warning" />

        <!--  Key changed: possible man-in-the-middle  -->
        <ui:FAInfoBar Title="{Binding WarningTitle}"
                      IsClosable="False"
                      IsOpen="{Binding IsKeyChanged}"
                      IsVisible="{Binding IsKeyChanged}"
                      Message="{Binding WarningMessage}"
                      Severity="Error" />

        <!--  Host Information  -->
        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="Host Details" />

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="12"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="8">

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding SessionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="Session:" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           IsVisible="{Binding SessionName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding SessionName}" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Host:" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           FontFamily="Cascadia Code,Consolas,Courier New"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Host}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Port:" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           FontFamily="Cascadia Code,Consolas,Courier New"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Port}" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Key Type:" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           FontFamily="Cascadia Code,Consolas,Courier New"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding KeyType}" />

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Fingerprint:" />
                <SelectableTextBlock Grid.Row="4"
                                     Grid.Column="1"
                                     FontFamily="Cascadia Code,Consolas,Courier New"
                                     FontSize="11"
                                     Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                     Text="{Binding Fingerprint}" />

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Legacy:" />
                <SelectableTextBlock Grid.Row="5"
                                     Grid.Column="1"
                                     FontFamily="Cascadia Code,Consolas,Courier New"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     Text="{Binding FingerprintMD5}" />

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding IsKeyChanged}"
                           Text="Previously:" />
                <SelectableTextBlock Grid.Row="6"
                                     Grid.Column="1"
                                     FontFamily="Cascadia Code,Consolas,Courier New"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                     IsVisible="{Binding IsKeyChanged}"
                                     Text="{Binding KnownFingerprints}" />
            </Grid>
        </StackPanel>

        <ui:FAInfoBar Title="Verify the fingerprint"
                      IsClosable="False"
                      IsOpen="True"
                      Message="Compare the fingerprint with the one provided by the server administrator (e.g. ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub on the server). If you accept, the key is saved to ~/.ssh/known_hosts."
                      Severity="Informational" />
    </StackPanel>
</UserControl>
