<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives">
    <!--
        Session tabs (FATabView in the main window), close to the Windows 11 / Windows Terminal look.
    -->

    <Styles.Resources>
        <!--  Tab strip starts flush with the top of the sidebar card  -->
        <Thickness x:Key="TabViewHeaderPadding">0,0,0,0</Thickness>
        <!--  Terminal colours; App.ApplyTheme replaces them with the configured ones  -->
        <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#000000" />
        <SolidColorBrush x:Key="TerminalForegroundBrush" Color="#CCCCCC" />
    </Styles.Resources>

    <!--  The line under the tab strip ends where the rounded top right corner of the session surface begins  -->
    <Style Selector="ui|FATabView /template/ Border#RightBottomBorderLine">
        <Setter Property="Margin" Value="0,0,3,0" />
    </Style>

    <!--  Same radius as the panes (sidebar, session surface) instead of the larger flyout radius  -->
    <Style Selector="ui|FATabViewItem">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>

    <!--
        The first tab starts at the left edge of the session surface, so its left border runs straight
        into the border of the surface (FluentAvalonia insets the tabs by 2px). The outward curve at
        its bottom left would stick out of the surface.
    -->
    <Style Selector="ui|FATabView /template/ uip|FATabViewListView#TabListView">
        <Setter Property="Margin" Value="-2,0,0,0" />
    </Style>
    <!--
        Selected tabs reach 1px to the left over their neighbour; the first one would leave the tab strip
        and lose its border. It also reaches down to the surface, so its left line has no gap.
    -->
    <Style Selector="ui|FATabViewItem:nth-child(1):selected /template/ Border#TabContainerBorder">
        <Setter Property="Margin" Value="0,0,-1,0" />
    </Style>
    <Style Selector="uip|FATabViewListView /template/ Grid#LeftLineHost">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="uip|FATabViewListView /template/ ScrollViewer#ScrollViewer /template/ Border#Column0MinWidthSpacer">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ui|FATabView /template/ Border#LeftBottomBorderLine">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ui|FATabViewItem:nth-child(1) /template/ Path#LeftRadiusRenderArc">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ui|FATabViewItem:nth-child(1) /template/ Path#SelectedBackgroundPath">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--
        The selected tab's surface ends 1px above the tab strip's bottom line; FluentAvalonia hides that
        line under the selected tab, which left a dark gap between tab and content. Fill it with the tab colour.
    -->
    <Style Selector="ui|FATabViewItem:selected /template/ Border#BottomBorderLine">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Margin" Value="-1,0" />
        <Setter Property="Background" Value="{DynamicResource TabViewItemHeaderBackgroundSelected}" />
    </Style>

    <!--
        While the terminal is shown (TabView class "terminal"), the selected tab takes the terminal's
        colours and merges into it, like in Windows Terminal. In the file view it keeps the surface colour,
        and so it does in a split layout, where the surface with the panes is below it.
    -->
    <Style Selector="ui|FATabView.terminal:not(.split) ui|FATabViewItem:selected">
        <Style Selector="^ /template/ Border#BottomBorderLine">
            <Setter Property="Background" Value="{DynamicResource TerminalBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Path#SelectedBackgroundPath">
            <Setter Property="Fill" Value="{DynamicResource TerminalBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Border#TabContainerBorder">
            <Setter Property="Background" Value="{DynamicResource TerminalBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TerminalForegroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Button#CloseButton">
            <Setter Property="Foreground" Value="{DynamicResource TerminalForegroundBrush}" />
        </Style>
    </Style>

    <!--  Surface of a split layout: continues the selected tab; the panes lie on it as cards  -->
    <Style Selector="Border.paneSurface.split">
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TabViewBorderBrush}" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="CornerRadius" Value="0,4,4,4" />
    </Style>

    <!--
        Close and add buttons: FluentAvalonia draws them as glyphs of a thin symbol font, which
        subpixel text rendering turns into red/blue fringes (a "pink x"). The app's path icons
        render neutral and match the other icons.
    -->
    <Style Selector="ui|FATabViewItem /template/ Button#CloseButton">
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <PathIcon Width="10"
                          Height="10"
                          Data="{StaticResource dismiss_regular}" />
            </DataTemplate>
        </Setter>
    </Style>
    <!--  Inactive tabs are muted (text is already secondary); the close button follows on hover  -->
    <Style Selector="ui|FATabViewItem:not(:selected):not(:pointerover) /template/ Button#CloseButton">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style Selector="ui|FATabView /template/ Button#AddButton">
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <PathIcon Width="12"
                          Height="12"
                          Data="{StaticResource add_regular}" />
            </DataTemplate>
        </Setter>
    </Style>
</Styles>
