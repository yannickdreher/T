	<Application.Styles>
		<FluentTheme  DensityStyle="Compact"/>
		<sty:FluentAvaloniaTheme PreferSystemTheme="True"
								 PreferUserAccentColor="True"/>

		<!-- DataGrid theme -->
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

		<!-- Global GridSplitter styling -->
		<Style Selector="GridSplitter[ResizeDirection=Columns]">
			<Setter Property="Width" Value="4"/>
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<!-- Card styling -->
		<Style Selector="Border.Panel">
			<Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
		</Style>

		<!-- Compact tree items -->
		<Style Selector="TreeViewItem">
			<Setter Property="MinHeight" Value="26"/>
		</Style>

		<!-- Subtle tooltips -->
		<Style Selector="ToolTip">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Padding" Value="8,4"/>
		</Style>

		<!-- DataGrid refinement -->
		<Style Selector="DataGrid">
			<Setter Property="RowHeight" Value="28"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="DataGridColumnHeader">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<!-- FAContentDialog style overrides -->
		<Style Selector="ui|FAContentDialog">
			<Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="MinWidth" Value="720"/>
		</Style>
	</Application.Styles>
</Application>